# GitHub Secrets à configurer dans Settings > Secrets > Actions

# AWS - Credentials IAM pour Terraform
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Registry Docker privé AWS
PRIVATE_REGISTRY_PUBLIC_IP=<IP_REGISTRY>:443
PRIVATE_REGISTRY_USERNAME=admin
PRIVATE_REGISTRY_PASSWORD=your_registry_password
# Contenu du certificat SSL self-signed du registry (généré par Ansible)
# On le récup avec : ssh ubuntu@<IP_REGISTRY> "cat /home/ubuntu/registry/nginx/certs/registry.crt"
REGISTRY_CERT=BEGIN CERTIFICATE-...-END CERTIFICATE

# BDD MySQL
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=tp_cicd
MYSQL_USER=your_db_user

# GITHUB_TOKEN est automatiquement fourni par GitHub Actions
# (pas besoin de le créer manuellement)
